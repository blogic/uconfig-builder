    "i18n:extract": "node tools/i18n-extract.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.5",
    "intl-messageformat": "^11.2.13",
    "json-schema-to-typescript": "^15.0.4",
    "svelte": "^5.28.2",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.1.5",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "@formatjs/intl": "^4.1.13",
    "bootstrap-icons": "^1.13.1"
  }
